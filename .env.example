# Local development defaults only. Replace before any shared deployment.
POSTGRES_DB=foody_delivery
POSTGRES_USER=foody
POSTGRES_PASSWORD=foody_local
POSTGRES_PORT=5432
BACKEND_PORT=8080

# JWT signing configuration. Use a 32+ character text secret or Base64 encoding
# of at least 32 bytes. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-secret-of-at-least-32-characters
JWT_ISSUER=foody-delivery
JWT_EXPIRATION_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:5173

# Nominatim public service configuration. Use a real, monitored contact address in shared deployments.
# Public Nominatim is limited to one request per second and is not intended for bulk geocoding.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=foody-delivery/1.0 (contact: admin@example.com)
NOMINATIM_CONNECT_TIMEOUT=2s
NOMINATIM_READ_TIMEOUT=5s

# Resilience and inbound rate limits (all mechanisms are local to one backend instance).
RATE_LIMIT_LOGIN_CAPACITY=10
RATE_LIMIT_LOGIN_PERIOD=1m
RATE_LIMIT_REGISTER_CAPACITY=5
RATE_LIMIT_REGISTER_PERIOD=1m
RATE_LIMIT_GEOCODING_CAPACITY=3
RATE_LIMIT_GEOCODING_PERIOD=1m
NOMINATIM_RETRY_MAX_ATTEMPTS=3
NOMINATIM_RETRY_INITIAL_DELAY=1s
NOMINATIM_RETRY_MAX_DELAY=5s
NOMINATIM_RETRY_MULTIPLIER=2.0
NOMINATIM_RETRY_JITTER=0.2
