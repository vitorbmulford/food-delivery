# Local development defaults only. Replace before any shared deployment.
POSTGRES_DB=foody_delivery
POSTGRES_USER=foody
POSTGRES_PASSWORD=foody_local
POSTGRES_PORT=5432
BACKEND_PORT=8080

# JWT signing configuration. Use a 32+ character text secret or Base64 encoding
# of at least 32 bytes. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-secret-of-at-least-32-characters
JWT_ISSUER=foody-delivery
JWT_EXPIRATION_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:5173
